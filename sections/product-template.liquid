<section class="section-padding product-hero-section" style="padding-bottom: 0;">
  <div class="container product-template-grid">
    <!-- Gallery Column -->
    <div class="product-gallery">
      <div id="mainImageContainer" class="main-image-viewport">
        <img src="{{ product.featured_image | img_url: '800x800' }}"
             alt="{{ product.title }}"
             id="mainProductImage"
             style="width:100%; height:100%; object-fit:contain; border-radius:12px;">
      </div>
      
      <!-- Thumbnail Strip -->
      <div class="thumbnail-strip">
        {% for image in product.images limit:8 %}
        <button class="thumb-button {% if forloop.first %}active{% endif %}"
                data-image-url="{{ image | img_url: '800x800' }}"
                aria-label="Product image {{ forloop.index }}">
          <img src="{{ image | img_url: '200x200' }}" alt="{{ product.title }}">
        </button>
        {% endfor %}
      </div>
    </div>
    
    <!-- Info Column -->
    <div class="product-details">
<h1 class="product-title">{% assign pt_title_words = product.title | default: 'PostureTru™ Smart Posture Corrector' | split: ' ' %}{% for word in pt_title_words %}<span class="intro-word">{{ word }}</span>{% unless forloop.last %}&nbsp;{% endunless %}{% endfor %}</h1>
      
      
      <div class="product-pricing">
        {% assign _fv = product.selected_or_first_available_variant %}
        {% if _fv.compare_at_price > _fv.price %}
        <span id="priceCompare" class="price-compare" style="font-size:22px;color:#999;text-decoration:line-through;text-decoration-color:#E74C3C;text-decoration-thickness:2px;margin-right:0;">{{ _fv.compare_at_price | money }}</span>
        {% else %}
        <span id="priceCompare" class="price-compare" style="font-size:22px;color:#999;text-decoration:line-through;text-decoration-color:#E74C3C;text-decoration-thickness:2px;margin-right:0;display:none;"></span>
        {% endif %}

        <span id="priceCurrent" class="price-current" style="font-size:28px;font-weight:800;color:#1B4965;letter-spacing:-1px;">{{ _fv.price | money }}</span>

        {% if _fv.compare_at_price > _fv.price %}
        <div id="saveBadge" style="margin-top:8px;display:block;">
          <span style="background:#E74C3C;color:white;font-size:13px;font-weight:700;padding:4px 10px;border-radius:20px;letter-spacing:0.05em;">SAVE 50%</span>
        </div>
        {% else %}
        <div id="saveBadge" style="margin-top:8px;display:none;">
          <span style="background:#E74C3C;color:white;font-size:13px;font-weight:700;padding:4px 10px;border-radius:20px;letter-spacing:0.05em;">SAVE 50%</span>
        </div>
        {% endif %}
      </div>
      
      <div class="mini-trust-row">
        <div class="mini-trust-badge">
          {% render 'icon-shield' %}
          <span>30 Day Returns</span>
        </div>
        <div class="mini-trust-badge">
          {% render 'icon-truck' %}
          <span>Free Shipping</span>
        </div>
        <div class="mini-trust-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          <span>Secure Checkout</span>
        </div>
      </div>

      <div class="product-short-description entrance-fade">
        {{ section.settings.short_description }}
      </div>
      
      <!-- Interactive ATC Box -->
      <div class="atc-section">

        <!-- Color Selector -->
        <div class="color-selector" id="colorSelector">
          <p class="color-selector-label">Color: <span id="colorSelectedName">{{ product.variants.first.option1 }}</span></p>
          <div class="color-pills">
            {% for variant in product.variants %}
              {% case variant.option1 %}
                {% when 'Black' %}{% assign swatch_hex = '#1C1C1C' %}
                {% when 'Pink' %}{% assign swatch_hex = '#E8A0B4' %}
                {% when 'Blue' %}{% assign swatch_hex = '#5B9BD5' %}
                {% else %}{% assign swatch_hex = '#CCCCCC' %}
              {% endcase %}
              <button type="button"
                      class="color-pill{% if forloop.first %} active{% endif %}"
                      data-variant-id="{{ variant.id }}"
                      data-color="{{ variant.option1 }}"
                      data-price="{{ variant.price }}"
                      data-compare="{{ variant.compare_at_price | default: 0 }}"
                      data-available="{{ variant.available }}"
                      aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
                <span class="swatch-dot" style="background:{{ swatch_hex }};"></span>
                {{ variant.option1 }}
              </button>
            {% endfor %}
          </div>
          <p class="color-size-note">One size — fits most.</p>
        </div>

        <!-- Quantity Selector and CTA -->
        <div class="quantity-row">
          <div class="quantity-selector">
            <button id="qtyMinus" class="qty-btn" aria-label="Decrease Quantity">-</button>
            <input type="text" id="productQty" class="qty-input" value="1" readonly aria-label="Product Quantity">
            <button id="qtyPlus" class="qty-btn" aria-label="Increase Quantity">+</button>
          </div>
          
          {% form 'product', product, id: 'product-form-main' %}
            <input type="hidden" name="id" value="{{ product.variants.first.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="btn btn-secondary btn-full" style="flex: 1; margin:0;">
              Add to Cart
            </button>
          {% endform %}
        </div>
        
        <div class="payment-buttons-wrap">
          {% form 'product', product, id: 'product-form-payment' %}
            <input type="hidden" name="id" value="{{ product.variants.first.id }}">
            <input type="hidden" name="quantity" value="1">
            {{ form | payment_button }}
          {% endform %}
        </div>

        <div class="shipping-promo-box">
          {% render 'icon-truck' %}
          <div class="shipping-promo-text">
            <strong>FREE Tracked Shipping</strong> to Canada, Australia, UK & NZ. Delivery in 6 to 14 business days.
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.color-selector { margin-bottom: 20px; }
.color-selector-label { font-size: 14px; font-weight: 600; color: #1B4965; margin-bottom: 10px; line-height: 1.4; }
.color-selector-label #colorSelectedName { font-weight: 400; color: #7F8C8D; }
.color-pills { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 8px; }
.color-pill {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 7px 16px;
  border: 1.5px solid #CBD5DC; border-radius: 20px;
  background: #fff; font-family: inherit; font-size: 14px; font-weight: 500; color: #1B4965;
  cursor: pointer; transition: border-color 0.2s, background 0.2s, color 0.2s;
}
.color-pill .swatch-dot { width: 12px; height: 12px; border-radius: 50%; border: 1px solid rgba(0,0,0,0.12); flex-shrink: 0; }
.color-pill.active { border-color: #1B4965; background: #1B4965; color: #fff; }
.color-pill.active .swatch-dot { border-color: rgba(255,255,255,0.35); }
.color-pill:hover:not(.active) { border-color: #1B4965; }
.color-pill[data-available="false"] { opacity: 0.4; cursor: not-allowed; text-decoration: line-through; }
.color-size-note { font-size: 13px; color: #7F8C8D; margin: 4px 0 0; }
</style>

<script>
(function(){
  var pills    = document.querySelectorAll('.color-pill');
  var nameEl   = document.getElementById('colorSelectedName');
  var priceEl  = document.getElementById('priceCurrent');
  var cmpEl    = document.getElementById('priceCompare');
  var saveEl   = document.getElementById('saveBadge');
  var formIds  = document.querySelectorAll('input[name="id"]');

  function fmt(cents) {
    return '$' + (cents / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  pills.forEach(function(pill) {
    pill.addEventListener('click', function() {
      if (pill.dataset.available === 'false') return;

      pills.forEach(function(p) { p.classList.remove('active'); p.setAttribute('aria-pressed', 'false'); });
      pill.classList.add('active');
      pill.setAttribute('aria-pressed', 'true');

      var vid     = pill.dataset.variantId;
      var color   = pill.dataset.color;
      var price   = parseInt(pill.dataset.price, 10);
      var compare = parseInt(pill.dataset.compare, 10) || 0;

      formIds.forEach(function(inp) { inp.value = vid; });
      if (nameEl)  nameEl.textContent = color;
      if (priceEl) priceEl.textContent = fmt(price);

      if (compare > price) {
        if (cmpEl)  { cmpEl.textContent = fmt(compare); cmpEl.style.display = ''; }
        if (saveEl) saveEl.style.display = 'block';
      } else {
        if (cmpEl)  { cmpEl.textContent = ''; cmpEl.style.display = 'none'; }
        if (saveEl) saveEl.style.display = 'none';
      }
    });
  });
})();
</script>

<script>
  document.querySelectorAll('.thumb-button').forEach(btn => {
    btn.addEventListener('click', () => {
      document.getElementById('mainProductImage').src = btn.dataset.imageUrl;
      document.querySelectorAll('.thumb-button').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    });
  });
</script>

<script>
(function(){
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var words = document.querySelectorAll('.product-title .intro-word');
  var shortDesc = document.querySelector('.product-short-description');
  var img = document.getElementById('mainImageContainer');
  var trigger = document.querySelector('.product-details') || shortDesc;
  var played = false;

  function run(){
    if (played) return;
    played = true;

    var staggerBudget = 300;
    var stagger = words.length ? Math.min(32, staggerBudget / words.length) : 32;
    var wordTransition = 560;

    words.forEach(function(w){
      var dx = (Math.random() * 90 - 45).toFixed(0);
      var dy = (Math.random() * 70 - 35).toFixed(0);
      var rot = (Math.random() * 18 - 9).toFixed(1);
      w.style.transform = 'translate(' + dx + 'px,' + dy + 'px) rotate(' + rot + 'deg)';
    });
    void document.body.offsetHeight;
    words.forEach(function(w, i){
      var delay = i * stagger;
      w.style.transition = 'transform ' + wordTransition + 'ms cubic-bezier(0.16,1,0.3,1) ' + delay + 'ms, opacity 420ms ease-out ' + delay + 'ms';
      w.style.opacity = '1';
      w.style.transform = 'translate(0,0) rotate(0deg)';
    });

    var wordsFinishAt = words.length ? (words.length - 1) * stagger + wordTransition : 0;

    if (shortDesc) {
      var descDelay = wordsFinishAt + 80;
      shortDesc.style.transition = 'opacity 480ms ease-out ' + descDelay + 'ms, transform 480ms cubic-bezier(0.16,1,0.3,1) ' + descDelay + 'ms';
      shortDesc.style.opacity = '1';
      shortDesc.style.transform = 'translateY(0)';
    }

  }

  function inView(el){
    var r = el.getBoundingClientRect();
    return r.top < (window.innerHeight || document.documentElement.clientHeight) * 0.85 && r.bottom > 0;
  }

  if (trigger && inView(trigger)) { run(); }
  if (trigger && 'IntersectionObserver' in window) {
    var obs = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if (e.isIntersecting) { run(); obs.disconnect(); } });
    }, { threshold: 0.2 });
    obs.observe(trigger);
  } else {
    run();
  }
})();
</script>

{% schema %}
{
  "name": "Product Details",
  "settings": [
    {
      "type": "textarea",
      "id": "short_description",
      "label": "Short Description",
      "default": "Verta is built around a simple idea: most slouching is not a posture problem, it is an attention problem. The moment your attention drifts and your posture follows, Verta meets you with a gentle vibration, a quiet nudge back to how you actually want to sit. Straighten up, and the vibration stops. No straps, no restriction, just real time feedback that helps awareness become habit."
    }
  ]
}
{% endschema %}

<section class="final-cta section-padding" id="finalCtaSection">
  <div class="container">
    <h2>{% assign fc_words = section.settings.title | default: 'Better Posture Starts With Awareness' | split: ' ' %}{% for word in fc_words %}<span class="intro-word">{{ word }}</span>{% unless forloop.last %}&nbsp;{% endunless %}{% endfor %}</h2>
    <p class="entrance-fade">{{ section.settings.copy | default: 'Verta is designed to help you build better posture habits over time, one gentle reminder at a time. Try it for yourself and notice the difference awareness can make.' }}</p>
    <div class="entrance-fade">
      <a href="{{ section.settings.cta_link | default: '/products/posturetru' }}" class="btn final-cta-btn">
        {{ section.settings.cta_text | default: 'Get Verta Today' }}
      </a>
    </div>
    <span class="final-cta-subtext entrance-fade">{{ section.settings.sub_text | default: '30 day money back guarantee. Free shipping on all orders.' }}</span>
  </div>
</section>

{% schema %}
{
  "name": "Final CTA",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Better Posture Starts With Awareness"
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Description",
      "default": "Verta is designed to help you build better posture habits over time, one gentle reminder at a time. Try it for yourself and notice the difference awareness can make."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "Get Verta Today"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    },
    {
      "type": "text",
      "id": "sub_text",
      "label": "Subheading Subtext",
      "default": "30 day money back guarantee. Free shipping on all orders."
    }
  ],
  "presets": [
    {
      "name": "Final CTA",
      "category": "Hero"
    }
  ]
}
{% endschema %}
